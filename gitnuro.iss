; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppName "GitMiro"
#define MyAppPublisher "Hugodehu (fork of Gitnuro by Abdelilah El Aissaoui)"
#define MyAppURL "https://github.com/Isipharm/GitMiro"
#define MyAppExeName "GitMiro.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
; New AppId so GitMiro can be installed next to the official Gitnuro instead of replacing it
AppId={{D40B5168-4F1E-4F53-B268-D312D3D5D8F0}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
; Installs for the current user only (%LOCALAPPDATA%\Programs), so no administrator rights are needed.
; The setup still offers an all users install to administrators.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
DisableProgramGroupPage=yes
Compression=lzma
OutputBaseFilename={#MyAppName}_Windows_Installer_{#MyAppVersion}
SetupIconFile=icons\icon.ico
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "app\build\compose\binaries\main\app\GitMiro\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "app\build\compose\binaries\main\app\GitMiro\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall

